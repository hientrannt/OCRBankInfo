# API key Claude (https://console.anthropic.com) - dùng để đọc ảnh với độ chính xác cao nhất
ANTHROPIC_API_KEY=
# Model dùng để đọc ảnh (mặc định claude-opus-5-5; có thể đổi sang claude-sonnet-5-5 để rẻ hơn)
OCR_MODEL=claude-opus-5-5
# Mật khẩu truy cập (nên đặt khi đưa lên Vercel/Internet để người lạ không dùng được API key)
APP_PASSWORD=
# API key Gemini (https://aistudio.google.com/apikey) - tuỳ chọn, nếu muốn dùng Gemini thay Claude
GEMINI_API_KEY=
# Model Gemini (mặc định gemini-2.5-flash)
GEMINI_MODEL=
